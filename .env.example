# ── Application ────────────────────────────────────────────────────
APP_NAME="Research Funding & Innovation Intelligence Platform"
DEBUG=false
ENVIRONMENT=production

# ── Security ── generate with: openssl rand -hex 64 ───────────────
SECRET_KEY=REPLACE_WITH_A_64_BYTE_HEX_SECRET

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=rfip_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=rfip_db

# ── CORS ───────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:5173"]

# ── Email ──────────────────────────────────────────────────────────
EMAILS_ENABLED=false
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# ── Frontend URL ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost

# ── First superuser ────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@rfip.dev
FIRST_SUPERUSER_PASSWORD=Admin@123!
FIRST_SUPERUSER_NAME="Platform Administrator"
