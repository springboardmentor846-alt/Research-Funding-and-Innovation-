# App Execution Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_super_secret_enterprise_key_32bytes!

# PostgreSQL Primary Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=funding_platform
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/funding_platform

# MongoDB Document Database
MONGO_USER=admin
MONGO_PASSWORD=mongo_password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=funding_unstructured_docs
MONGO_URI=mongodb://admin:mongo_password@localhost:27017

# Redis Cache & Task Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Third-Party AI Services & Data Sources
OPENAI_API_KEY=your_openai_api_key_here
ORCID_CLIENT_ID=your_orcid_client_id
ORCID_CLIENT_SECRET=your_orcid_client_secret
