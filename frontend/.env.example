# Frontend Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# API Configuration
# ============================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000

# ============================================
# Application Settings
# ============================================
VITE_APP_NAME=Research Funding & Innovation Platform
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AI-powered funding opportunity discovery and innovation intelligence platform

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_THEME_SWITCHER=true

# ============================================
# External Services
# ============================================
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_HOTJAR_ID=

# ============================================
# Development Settings
# ============================================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# ============================================
# Authentication
# ============================================
VITE_AUTH_TOKEN_KEY=auth_token
VITE_AUTH_REFRESH_KEY=auth_refresh
VITE_SESSION_TIMEOUT=30

# ============================================
# UI Configuration
# ============================================
VITE_DEFAULT_THEME=dark
VITE_ENABLE_ANIMATIONS=true
VITE_PAGE_SIZE=10
VITE_MAX_SEARCH_RESULTS=100
