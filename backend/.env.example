SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql://platform:platform@localhost:5432/innovation_platform
# Frontend URL used to build the password reset link sent in emails
FRONTEND_URL=http://localhost:5173

# SMTP settings for password reset emails.
# If left empty, reset emails are logged to the console instead of sent
# (useful for local development) — the app will not crash or block.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Gemini API key for the AI Assistant chatbot.
# Free key: https://aistudio.google.com/apikey
# If left empty, the chatbot endpoint returns a clear 503 error instead
# of crashing the server.
GEMINI_API_KEY=
LENS_API_KEY=